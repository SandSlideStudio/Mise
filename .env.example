# Copy to .env and change every secret before exposing this server to a network.

# --- Database -------------------------------------------------------------
POSTGRES_USER=mise
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_DB=mise
# Host port the Postgres container is published on. Kept off 5432 so it never
# fights a Postgres already installed on the host.
POSTGRES_PORT=5433

# Only `npm run dev` reads this, and it talks to the published port above. The
# app container ignores it: compose gives that one its own URL pointing at the
# "db" service on the internal network.
DATABASE_URL=postgres://mise:change-me-in-production@localhost:5433/mise

# --- Server ---------------------------------------------------------------
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# Signs session cookies. Must be at least 32 characters and secret.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# Set to true when the server is reached over HTTPS (behind a reverse proxy).
# Marks session cookies Secure. Leave false only for local development.
COOKIE_SECURE=false

# Where uploaded recipe photos are written.
UPLOAD_DIR=./data/uploads
