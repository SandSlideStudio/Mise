# Mise settings for this kitchen. install.sh fills in the two secrets for you;
# if you set this up by hand, replace both with long random strings:
#   openssl rand -hex 32

# Signs everyone's sign-in cookies. At least 32 characters.
SESSION_SECRET=change-me
# The database password. Only Mise ever uses it.
POSTGRES_PASSWORD=change-me
# Asked for once, when the kitchen is set up, so nobody else can claim a new
# server. Leave it empty and the setup link is printed in: docker compose logs app
SETUP_TOKEN=

# Which release to run. "2" follows every 2.x update; "2.0.0" stays put.
MISE_VERSION=2

# The ports Mise answers on: http://<this machine>:3000, and HTTPS on 3443
# once it's turned on in Settings → Connection. On a server of its own with
# a domain, set PORT=80 and HTTPS_PORT=443 and let Mise get the certificate.
PORT=3000
HTTPS_PORT=3443

# From outside the kitchen network, only devices approved in Settings →
# Devices get in. "open" turns that off: a way back in if every approved
# device is lost on a server with no kitchen network. Not for everyday use.
OUTSIDE_ACCESS=approved

# Caddy in front instead, for HTTPS: set MISE_DOMAIN to the name that points
# at this machine (for example kitchen.example.com), uncomment
# COMPOSE_PROFILES, and change the three lines under it to:
# COOKIE_SECURE=true, TRUST_PROXY=1, MISE_BIND=127.0.0.1
# Then: docker compose up -d
MISE_DOMAIN=
# COMPOSE_PROFILES=https
COOKIE_SECURE=false
TRUST_PROXY=false
MISE_BIND=0.0.0.0
