# Mise settings for this kitchen. install.sh fills in the two secrets for you;
# if you set this up by hand, replace both with long random strings:
#   openssl rand -hex 32

# Signs everyone's sign-in cookies. At least 32 characters.
SESSION_SECRET=change-me
# The database password. Only Mise ever uses it.
POSTGRES_PASSWORD=change-me
# Asked for once, when the kitchen is set up, so nobody else can claim a new
# server. Leave it empty and the setup link is printed in: docker compose logs app
SETUP_TOKEN=

# Which release to run. "1" follows every 1.x update; "1.0.0" stays put.
MISE_VERSION=1

# The port Mise answers on, at http://<this machine>:3000
PORT=3000

# For HTTPS through Caddy: set MISE_DOMAIN to the name that points at this
# machine (for example kitchen.example.com) and change the three lines under
# it to: COOKIE_SECURE=true, TRUST_PROXY=1, MISE_BIND=127.0.0.1
# Then start with: docker compose --profile https up -d
MISE_DOMAIN=
COOKIE_SECURE=false
TRUST_PROXY=false
MISE_BIND=0.0.0.0
